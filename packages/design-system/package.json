{
  "name": "@meu-orcamento/design-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Design system do Meu Orçamento: tokens, formatadores e componentes (web e React Native).",
  "main": "./src/web.ts",
  "exports": {
    ".": {
      "react-native": "./src/native.ts",
      "browser": "./src/web.ts",
      "default": "./src/web.ts"
    },
    "./tokens.css": "./src/core/tokens.css",
    "./web.css": "./src/web/base.css"
  },
  "scripts": {
    "gen:css": "node --experimental-strip-types scripts/gen-css.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "^16.0.0",
    "jsdom": "^25.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "react-native": "0.76.5",
    "react-native-svg": "15.8.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {}
}
